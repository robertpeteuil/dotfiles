#!/usr/bin/env zsh
# cspell: disable
# shellcheck shell=zsh

# Create a project-local docs/ symlink to ~/Main/docs/projects/<slug>.

project-link-docs() {
  emulate -L zsh
  setopt ERR_EXIT PIPE_FAIL

  local DOCS_BASE="${PROJECT_DOCS_BASE:-$HOME/Main/docs/projects}"
  local PROJECT_NAME=""
  local UPDATE_GITIGNORE=false
  local ROOT_DIR DEFAULT_SLUG SLUG TARGET_DIR DOCS_LINK DIR_STATUS CURRENT_TARGET

  usage() {
    cat <<'EOF'
Usage: project-link-docs [-n project-name] [-b docs-base] [-i]

Creates <docs-base>/<slug> and symlinks the current project's docs/ to that
directory.

Options:
  -n, --name NAME   Use NAME as the project name slug without prompting
  -b, --base DIR    Use DIR as the project docs base directory
                    (default: ~/Main/docs/projects, or PROJECT_DOCS_BASE)
  -i, --ignore      Add /docs and /docs/ to the project's .gitignore
                    if they are not already present
  -h, --help        Show this help message

Environment:
  PROJECT_DOCS_BASE Override the default docs base directory
                    (default: ~/Main/docs/projects)
EOF
  }

  slugify() {
    local value="$1"

    value="$(printf '%s' "$value" | tr '[:upper:]' '[:lower:]')"
    value="$(printf '%s' "$value" | sed -E 's/^[[:space:]._-]+//; s/[[:space:]._-]+$//; s/[^[:alnum:]._~-]+/-/g; s/-+/-/g')"

    printf '%s' "$value"
  }

  project_root() {
    if command -v git >/dev/null 2>&1 && git rev-parse --show-toplevel >/dev/null 2>&1; then
      git rev-parse --show-toplevel
    else
      pwd -P
    fi
  }

  expand_path() {
    local value="$1"

    case "$value" in
      \~)
        printf '%s' "$HOME"
        ;;
      \~/*)
        printf '%s/%s' "$HOME" "${value#\~/}"
        ;;
      *)
        printf '%s' "$value"
        ;;
    esac
  }

  ensure_gitignore_entries() {
    local root_dir="$1"
    local gitignore="$root_dir/.gitignore"
    local entry
    local last_char

    touch "$gitignore"

    for entry in /docs /docs/; do
      if ! grep -Fxq -- "$entry" "$gitignore"; then
        if [[ -s "$gitignore" ]]; then
          last_char="$(tail -c 1 "$gitignore")"
          if [[ -n "$last_char" ]]; then
            printf '\n' >>"$gitignore"
          fi
        fi

        printf '%s\n' "$entry" >>"$gitignore"
      fi
    done
  }

  while (($#)); do
    case "$1" in
      -n|--name)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "Error: $1 requires a project name." >&2
          return 1
        fi
        PROJECT_NAME="$2"
        shift 2
        ;;
      --name=*)
        PROJECT_NAME="${1#--name=}"
        if [[ -z "$PROJECT_NAME" ]]; then
          echo "Error: --name requires a project name." >&2
          return 1
        fi
        shift
        ;;
      -b|--base)
        if [[ $# -lt 2 || -z "$2" ]]; then
          echo "Error: $1 requires a docs base directory." >&2
          return 1
        fi
        DOCS_BASE="$2"
        shift 2
        ;;
      --base=*)
        DOCS_BASE="${1#--base=}"
        if [[ -z "$DOCS_BASE" ]]; then
          echo "Error: --base requires a docs base directory." >&2
          return 1
        fi
        shift
        ;;
      -i|--ignore)
        UPDATE_GITIGNORE=true
        shift
        ;;
      -h|--help)
        usage
        return 0
        ;;
      *)
        echo "Error: unknown argument: $1" >&2
        usage >&2
        return 1
        ;;
    esac
  done

  ROOT_DIR="$(project_root)"
  DEFAULT_SLUG="$(slugify "$(basename "$ROOT_DIR")")"

  if [[ -z "$DEFAULT_SLUG" ]]; then
    DEFAULT_SLUG="project"
  fi

  if [[ -z "$PROJECT_NAME" ]]; then
    printf 'Project name slug [%s]: ' "$DEFAULT_SLUG"
    read -r PROJECT_NAME
  fi

  if [[ -z "$PROJECT_NAME" ]]; then
    SLUG="$DEFAULT_SLUG"
  else
    SLUG="$(slugify "$PROJECT_NAME")"
  fi

  if [[ -z "$SLUG" ]]; then
    echo "Error: project name slug cannot be empty." >&2
    return 1
  fi

  DOCS_BASE="$(expand_path "$DOCS_BASE")"
  TARGET_DIR="$DOCS_BASE/$SLUG"
  DOCS_LINK="$ROOT_DIR/docs"
  DIR_STATUS="existing"

  if [[ -e "$TARGET_DIR" && ! -d "$TARGET_DIR" ]]; then
    echo "Error: target exists but is not a directory: $TARGET_DIR" >&2
    return 1
  fi

  if [[ ! -d "$TARGET_DIR" ]]; then
    mkdir -p "$TARGET_DIR"
    DIR_STATUS="created"
  fi

  if [[ -L "$DOCS_LINK" ]]; then
    CURRENT_TARGET="$(readlink "$DOCS_LINK")"
    if [[ "$CURRENT_TARGET" != "$TARGET_DIR" ]]; then
      rm "$DOCS_LINK"
      ln -s "$TARGET_DIR" "$DOCS_LINK"
    fi
  elif [[ -e "$DOCS_LINK" ]]; then
    echo "Error: docs/ already exists and is not a symlink: $DOCS_LINK" >&2
    return 1
  else
    ln -s "$TARGET_DIR" "$DOCS_LINK"
  fi

  if [[ "$UPDATE_GITIGNORE" == true ]]; then
    ensure_gitignore_entries "$ROOT_DIR"
  fi

  echo "'docs/' symlinked to $DIR_STATUS $TARGET_DIR"
}

# If this file is executed directly, run the function. When it is sourced from
# zsh/rc.d/13-functions.zsh, only define the function.
if [[ "$ZSH_EVAL_CONTEXT" != *:file ]]; then
  project-link-docs "$@"
fi

# vim: ft=zsh
