#!/bin/bash
# cspell: disable

set -e

##  DOTFILES INSTALLER
#
#   A component of https://github.com/robertpeteuil/dotfiles
#

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"
DOTBOT_BIN="bin/dotbot"

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"


# -----------------------------------------------------------------------


#  TODO: Create new external config file that lists external repos
#        format: "repo-user/repo-name", "target-dit" \n "repo2", "dir2"
#           allow 'repo-user' portion of repo-url to be templatized for the current user
#           i.e. allow '{USER)/reponame' injects the envvar $USER for {USER}
#        how to specify public or private repos (they clone in different formats)


# Optional repos
DOTFILES_PRIVATE_REPO="robertpeteuil/dotfiles-private"
PRIVATE="private"
PRIVATEDIR="${DOTFILES_TARGET_DIR}/${PRIVATE}"

#  TODO: remove need for EXTERNALDIR variable
EXTERNALDIR="${DOTFILES_TARGET_DIR}/external"

DOTFILES_NVIM_REPO="robertpeteuil/dotfiles-nvim"
NVIMDIR="${DOTFILES_TARGET_DIR}/external/nvim"

DOTFILES_PI_REPO="robertpeteuil/dotfiles-pi"
PIDIR="${DOTFILES_TARGET_DIR}/pi"


# -----------------------------------------------------------------------

# INIT SUBMODULES
cd "${BASEDIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive
#  TODO: do i need to update the submodules if i want to keep the version specified by the repo?
git submodule update --init --recursive "${DOTBOT_DIR}"

# -----------------------------------------------------------------------


#  TODO: Rewrite this section
#        Read new config file
#        Call clone function for each entry in config to clone repo
#           Determine if repo is public or private?  if can acess via ssh-url, use it, otherwise use https
#           public repos: set repo 'push' remote to ssh version of url
#           private repos: use ssh repo url for both pull/push
#           Add '-d | --dev' script paramter to clone in dev mode (no shallow clone; no --depth 1)
#        Dont need 'update' functionality in this 'install' script, only in 'update' script

## CLONE PRIVATE DOTFILES REPO IF EXIST
if [[ -d "${PRIVATEDIR}/.git" ]]; then
  echo "private repo present - updating"
  cd "${PRIVATEDIR}"
  git remote update -p >/dev/null 2>&1
  git merge --ff-only @{u} >/dev/null 2>&1
elif git clone --quiet --depth 1 "git@github.com:${DOTFILES_PRIVATE_REPO}.git" "${PRIVATEDIR}" 2>/dev/null; then
  echo "private repo cloned"
fi

## CLONE PUBLIC NVIM DOTFILES REPO IF AVAILABLE
# This optional split repo backs the conditional ~/.config/nvim Dotbot link.
# Warn and continue on clone/update failure so the rest of Dotbot can still run.
if [[ -d "${NVIMDIR}/.git" ]]; then
  echo "nvim repo present - updating"
  cd "${NVIMDIR}"
  if ! git remote update -p >/dev/null 2>&1 || ! git merge --ff-only @{u} >/dev/null 2>&1; then
    echo "WARNING: dotfiles-nvim update failed; continuing without updating nvim config" >&2
  fi
elif [[ ! -e "${NVIMDIR}" ]] || [[ -z "$(ls -A "${NVIMDIR}" 2>/dev/null)" ]]; then
  mkdir -p "${EXTERNALDIR}"  #  TODO: remove need for EXTERNALDIR variable
  if git clone --quiet --depth 1 "https://github.com/${DOTFILES_NVIM_REPO}.git" "${NVIMDIR}" 2>/dev/null; then
    echo "nvim repo cloned"
  else
    echo "WARNING: dotfiles-nvim clone failed; continuing without nvim config" >&2
  fi
else
  echo "WARNING: ${NVIMDIR} exists but is not a Git clone; skipping dotfiles-nvim" >&2
fi

## CLONE OPTIONAL PRIVATE CONFIG IF AVAILABLE
if [[ -d "${PIDIR}/.git" ]]; then
  echo "optional config repo present - updating"
  cd "${PIDIR}"
  if ! git remote update -p >/dev/null 2>&1 || ! git merge --ff-only @{u} >/dev/null 2>&1; then
    echo "WARNING: optional config update failed; continuing" >&2
  fi
elif [[ ! -e "${PIDIR}" ]] || [[ -z "$(ls -A "${PIDIR}" 2>/dev/null)" ]]; then
  mkdir -p "${EXTERNALDIR}"  #  TODO: remove need for EXTERNALDIR variable
  if git clone --quiet "git@github.com:${DOTFILES_PI_REPO}.git" "${PIDIR}" 2>/dev/null; then
    echo "optional config repo cloned"
  else
    echo "WARNING: optional config clone failed; continuing" >&2
  fi
else
  echo "WARNING: ${PIDIR} exists but is not a Git clone; skipping optional config" >&2
fi


# -----------------------------------------------------------------------

# RUN DOTBOT WITH BASE CONFIGURATION
"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"

# vim: ft=bash
