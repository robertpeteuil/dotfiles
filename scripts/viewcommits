#!/usr/bin/env bash

# Display recent commits grouped by Conventional Commit scope.

set -o pipefail

BRIGHT_GREEN=
BRIGHT_RED=
BRIGHT_MAGENTA=
MAGENTA=
YELLOW=
WHITE=
BRIGHT_BLUE=
BRIGHT_CYAN=
BLACK=
DEFAULT_FG=
DEFAULT_BG=
BRIGHT_CYAN_BG=
DIM=
RESET=

COMMIT_HASHES=()
COMMIT_DATES=()
COMMIT_TITLES=()
COMMIT_SCOPES=()
COMMIT_FILES=()
WRAPPED_LINES=()
RENDER_GROUPS=()

FILE_CROSS_SCOPE=0
FILE_RANK=0
FILE_TOTAL=0

usage() {
  printf '%s\n' \
    "Usage: ${0##*/} [options] [REVISION]" \
    '' \
    'Options:' \
    '  -C PATH     Read commits from the repository at PATH' \
    '  -d PATH     Same as -C' \
    '  -n COUNT    Limit commits (default: 15; REVISION is unlimited unless -n is set)' \
    '  -c          Compact output; omit blank lines between scope groups' \
    '  -r          Reverse/rebase order; display oldest commits and scopes first' \
    '  -h, --help  Show this help' \
    '' \
    'Arguments:' \
    '  REVISION    Git revision or range; bypasses current-branch-only selection'
}

setup_colors() {
  if [ -t 1 ] && [ -z "${NO_COLOR+x}" ]; then
    BRIGHT_GREEN=$'\033[92m'
    BRIGHT_RED=$'\033[91m'
    BRIGHT_MAGENTA=$'\033[95m'
    MAGENTA=$'\033[35m'
    YELLOW=$'\033[33m'
    WHITE=$'\033[37m'
    BRIGHT_BLUE=$'\033[94m'
    BRIGHT_CYAN=$'\033[96m'
    BLACK=$'\033[30m'
    DEFAULT_FG=$'\033[39m'
    DEFAULT_BG=$'\033[49m'
    BRIGHT_CYAN_BG=$'\033[106m'
    DIM=$'\033[2m'
    RESET=$'\033[0m'
  fi
}

terminal_width() {
  local width
  local tty_size

  width=

  # Read the size from the controlling PTY. Unlike tput, stty still sees the
  # terminal when this function's output is captured by command substitution.
  tty_size=$(stty size 2>/dev/null < /dev/tty || true)
  case "$tty_size" in
    *' '*) width=${tty_size##* } ;;
  esac
  case "$width" in
    ''|*[!0-9]*) width= ;;
    *) [ "$width" -gt 0 ] || width= ;;
  esac

  if [ -z "$width" ]; then
    width=${COLUMNS:-}
  fi

  if [ -z "$width" ] && command -v tput >/dev/null 2>&1; then
    width=$(tput cols 2>/dev/null || true)
  fi

  case "$width" in
    ''|*[!0-9]*) width=68 ;;
  esac

  if [ "$width" -lt 40 ]; then
    width=40
  fi

  printf '%s\n' "$width"
}

scope_from_title() {
  local title=$1
  local scope_pattern='^[[:alnum:]_-]+!?\(([^)]+)\)!?:[[:space:]]*'

  if [[ $title =~ $scope_pattern ]]; then
    printf '%s\n' "${BASH_REMATCH[1]}"
  else
    printf '%s\n' '(unscoped)'
  fi
}

changed_files() {
  local repo=$1
  local hash=$2

  git -C "$repo" diff-tree \
    --root --diff-merges=first-parent --no-commit-id --name-only -r "$hash" |
    awk 'BEGIN { separator = "" }
         { printf "%s%s", separator, $0; separator = ", " }
         END { print "" }'
}

collect_commits() {
  local repo=$1
  local revision=$2
  local count=$3
  local excluded_branch=${4:-}
  local reverse=$5
  local log_options
  local revision_args
  local hashes
  local hash
  local title
  local date
  local scope
  local files
  local index

  COMMIT_HASHES=()
  COMMIT_DATES=()
  COMMIT_TITLES=()
  COMMIT_SCOPES=()
  COMMIT_FILES=()

  log_options=()
  if [ -n "$count" ]; then
    log_options+=(-n "$count")
  fi
  if [ "$reverse" -eq 1 ]; then
    log_options+=(--reverse)
  fi

  revision_args=("$revision")
  if [ -n "$excluded_branch" ]; then
    revision_args+=(--not "--exclude=$excluded_branch" --branches)
  fi

  if ! hashes=$(git -C "$repo" log --format='%H' \
    "${log_options[@]}" "${revision_args[@]}" 2>/dev/null); then
    if [ -z "$(git -C "$repo" rev-list --all --max-count=1)" ]; then
      return 2
    fi

    # Repeat only the failed query so Git's native revision error remains visible.
    git -C "$repo" log --format='%H' \
      "${log_options[@]}" "${revision_args[@]}" >/dev/null
    return 1
  fi

  for hash in $hashes; do
    title=$(git -C "$repo" show -s --format='%s' "$hash") || return 1
    date=$(git -C "$repo" show -s --date=short --format='%ad' "$hash") || return 1
    scope=$(scope_from_title "$title")
    files=$(changed_files "$repo" "$hash") || return 1

    index=${#COMMIT_HASHES[@]}
    COMMIT_HASHES[index]=${hash:0:7}
    COMMIT_DATES[index]=$date
    COMMIT_TITLES[index]=$title
    COMMIT_SCOPES[index]=$scope
    COMMIT_FILES[index]=$files
  done
}

scope_field_width() {
  local max_length=0
  local length
  local index=0

  while [ "$index" -lt "${#COMMIT_SCOPES[@]}" ]; do
    length=${#COMMIT_SCOPES[$index]}
    if [ "$length" -gt "$max_length" ]; then
      max_length=$length
    fi
    index=$((index + 1))
  done

  # Two spaces separate the scope and SHA columns.
  printf '%s\n' "$((max_length + 2))"
}

wrap_text() {
  local text=$1
  local width=$2
  local line

  WRAPPED_LINES=()

  while IFS= read -r line; do
    WRAPPED_LINES[${#WRAPPED_LINES[@]}]=$line
  done < <(printf '%s\n' "$text" | fold -s -w "$width" | sed 's/[[:space:]]*$//')

  if [ "${#WRAPPED_LINES[@]}" -eq 0 ]; then
    WRAPPED_LINES[0]=
  fi
}

avoid_orphaned_date() {
  local date=$1
  local suffix="($date)"
  local last_index
  local previous_index
  local previous_line
  local last_word

  last_index=$((${#WRAPPED_LINES[@]} - 1))
  previous_index=$((last_index - 1))

  if [ "$last_index" -lt 1 ] || [ "${WRAPPED_LINES[$last_index]}" != "$suffix" ]; then
    return
  fi

  previous_line=${WRAPPED_LINES[$previous_index]}
  case "$previous_line" in
    *' '*)
      last_word=${previous_line##* }
      WRAPPED_LINES[previous_index]=${previous_line% *}
      WRAPPED_LINES[last_index]="$last_word $suffix"
      ;;
  esac
}

print_scope_label() {
  local label=$1
  local width=$2

  if [ "$label" = '(unscoped)' ]; then
    printf '%s(%s%s%s)%s' \
      "$WHITE" "$BRIGHT_GREEN" 'unscoped' "$WHITE" "$RESET"
    print_spaces "$((width - ${#label}))"
  else
    printf '%s%s%s' "$BRIGHT_GREEN" "$label" "$RESET"
    print_spaces "$((width - ${#label}))"
  fi
}

analyze_file() {
  local target_path=$1
  local target_commit=$2
  local reverse=$3
  local commit_count=${#COMMIT_HASHES[@]}
  local index
  local step
  local paths
  local path
  local first_scope=
  local scope

  FILE_CROSS_SCOPE=0
  FILE_RANK=0
  FILE_TOTAL=0

  if [ "$reverse" -eq 1 ]; then
    index=0
    step=1
  else
    index=$((commit_count - 1))
    step=-1
  fi

  while [ "$index" -ge 0 ] && [ "$index" -lt "$commit_count" ]; do
    IFS=',' read -r -a paths <<< "${COMMIT_FILES[$index]}"
    for path in "${paths[@]}"; do
      path=${path# }
      [ "$path" = "$target_path" ] || continue

      FILE_TOTAL=$((FILE_TOTAL + 1))
      if [ "$index" -eq "$target_commit" ]; then
        FILE_RANK=$FILE_TOTAL
      fi

      scope=${COMMIT_SCOPES[$index]}
      if [ -z "$first_scope" ]; then
        first_scope=$scope
      elif [ "$scope" != "$first_scope" ]; then
        FILE_CROSS_SCOPE=1
      fi
      break
    done

    index=$((index + step))
  done
}

print_file_path() {
  local path=$1
  local commit_index=$2
  local reverse=$3
  local directory=
  local basename=$path
  local basename_color=$BRIGHT_CYAN

  case "$path" in
    */*)
      directory=${path%/*}/
      basename=${path##*/}
      ;;
  esac

  analyze_file "$path" "$commit_index" "$reverse"
  if [ "$FILE_CROSS_SCOPE" -eq 1 ]; then
    basename_color=$BRIGHT_MAGENTA
  fi

  printf '%s%s%s%s' "$BRIGHT_BLUE" "$directory" "$basename_color" "$basename"
  if [ "$FILE_CROSS_SCOPE" -eq 1 ]; then
    printf '%s %s%s %s/%s %s%s ' \
      "$DEFAULT_BG" "$BRIGHT_CYAN_BG" "$BLACK" "$FILE_RANK" \
      "$FILE_TOTAL" "$DEFAULT_FG" "$DEFAULT_BG"
  fi
  printf '%s' "$RESET"
}

print_file_text() {
  local text=$1
  local commit_index=$2
  local reverse=$3
  local paths
  local path
  local path_index=0
  local trailing_comma=0

  case "$text" in
    *,)
      trailing_comma=1
      text=${text%,}
      ;;
  esac

  IFS=',' read -r -a paths <<< "$text"
  for path in "${paths[@]}"; do
    path=${path# }
    if [ "$path_index" -gt 0 ]; then
      printf ', '
    fi
    print_file_path "$path" "$commit_index" "$reverse"
    path_index=$((path_index + 1))
  done

  if [ "$trailing_comma" -eq 1 ]; then
    printf ','
  fi
}

print_spaces() {
  printf '%*s' "$1" ''
}

print_date() {
  local date=$1
  local year=${date%%-*}
  local remainder=${date#*-}
  local month=${remainder%%-*}
  local day=${remainder#*-}

  printf '%s(%s%s%s-%s%s%s-%s%s%s)%s' \
    "$WHITE" "$YELLOW" "$year" "$WHITE" \
    "$YELLOW" "$month" "$WHITE" "$YELLOW" "$day" \
    "$WHITE" "$RESET"
}

print_breaking_marker() {
  if [ -n "$1" ]; then
    printf '%s!%s' "$BRIGHT_RED" "$RESET"
  fi
}

print_title_line() {
  local line=$1
  local date=$2
  local format_prefix=${3:-0}
  local date_suffix="($date)"
  local prefix_pattern='^([[:alnum:]_-]+)(!)?(\(([^)]+)\))?(!)?:'
  local content=$line
  local prefix
  local type_part
  local scope_part
  local breaking_before
  local breaking_after
  local type_color
  local has_date=0

  case "$line" in
    *"$date_suffix")
      content=${line%"$date_suffix"}
      has_date=1
      ;;
  esac

  if [ "$format_prefix" -eq 1 ] && [[ $content =~ $prefix_pattern ]]; then
    prefix=${BASH_REMATCH[0]}
    type_part=${BASH_REMATCH[1]}
    breaking_before=${BASH_REMATCH[2]}
    scope_part=${BASH_REMATCH[4]}
    breaking_after=${BASH_REMATCH[5]}

    type_color=$MAGENTA
    if [ -n "$breaking_before" ] || [ -n "$breaking_after" ]; then
      type_color=$BRIGHT_RED
    fi

    printf '%s%s%s' "$type_color" "$type_part" "$RESET"
    print_breaking_marker "$breaking_before"

    if [ -n "${BASH_REMATCH[3]}" ]; then
      printf '(%s)' "$scope_part"
    fi

    print_breaking_marker "$breaking_after"
    printf ':'
    printf '%s%s%s' "$WHITE" "${content#"$prefix"}" "$RESET"
  else
    printf '%s%s%s' "$WHITE" "$content" "$RESET"
  fi

  if [ "$has_date" -eq 1 ]; then
    print_date "$date"
  fi
}

print_commit() {
  local index=$1
  local scope_label=$2
  local scope_width=$3
  local terminal_columns=$4
  local reverse=$5
  local title_indent=$((scope_width + 9))
  local content_width=$((terminal_columns - title_indent))
  local file_width
  local full_title
  local line_index

  if [ "$content_width" -lt 20 ]; then
    content_width=20
  fi

  full_title="${COMMIT_TITLES[$index]} (${COMMIT_DATES[$index]})"
  wrap_text "$full_title" "$content_width"
  avoid_orphaned_date "${COMMIT_DATES[$index]}"

  print_scope_label "$scope_label" "$scope_width"
  printf '%s%s%s  ' "$YELLOW" "${COMMIT_HASHES[$index]}" "$RESET"
  print_title_line "${WRAPPED_LINES[0]}" "${COMMIT_DATES[$index]}" 1
  printf '\n'

  line_index=1
  while [ "$line_index" -lt "${#WRAPPED_LINES[@]}" ]; do
    print_spaces "$title_indent"
    print_title_line "${WRAPPED_LINES[$line_index]}" "${COMMIT_DATES[$index]}"
    printf '\n'
    line_index=$((line_index + 1))
  done

  if [ -n "${COMMIT_FILES[$index]}" ]; then
    file_width=$((content_width - 2))
    if [ "$file_width" -lt 18 ]; then
      file_width=18
    fi
    wrap_text "${COMMIT_FILES[$index]}" "$file_width"

    print_spaces "$title_indent"
    printf '%s↳%s ' "$DIM" "$RESET"
    print_file_text "${WRAPPED_LINES[0]}" "$index" "$reverse"
    printf '\n'

    line_index=1
    while [ "$line_index" -lt "${#WRAPPED_LINES[@]}" ]; do
      print_spaces "$((title_indent + 2))"
      print_file_text "${WRAPPED_LINES[$line_index]}" "$index" "$reverse"
      printf '\n'
      line_index=$((line_index + 1))
    done
  fi
}

build_groups() {
  local reverse=$1
  local index=0
  local scope
  local existing
  local found
  local has_unscoped=0

  RENDER_GROUPS=()

  while [ "$index" -lt "${#COMMIT_HASHES[@]}" ]; do
    scope=${COMMIT_SCOPES[$index]}
    if [ "$scope" = '(unscoped)' ] && [ "$reverse" -eq 0 ]; then
      has_unscoped=1
      index=$((index + 1))
      continue
    fi

    found=0
    for existing in "${RENDER_GROUPS[@]}"; do
      if [ "$existing" = "$scope" ]; then
        found=1
        break
      fi
    done

    if [ "$found" -eq 0 ]; then
      RENDER_GROUPS[${#RENDER_GROUPS[@]}]=$scope
    fi

    index=$((index + 1))
  done

  if [ "$has_unscoped" -eq 1 ]; then
    RENDER_GROUPS[${#RENDER_GROUPS[@]}]='(unscoped)'
  fi
}

render_commits() {
  local scope_width=$1
  local terminal_columns=$2
  local reverse=$3
  local compact=$4
  local scope
  local first_scope=1
  local first_commit
  local index

  build_groups "$reverse"

  for scope in "${RENDER_GROUPS[@]}"; do
    if [ "$first_scope" -eq 0 ] && [ "$compact" -eq 0 ]; then
      printf '\n'
    fi
    first_scope=0
    first_commit=1
    index=0

    while [ "$index" -lt "${#COMMIT_HASHES[@]}" ]; do
      if [ "${COMMIT_SCOPES[$index]}" = "$scope" ]; then
        if [ "$first_commit" -eq 1 ]; then
          print_commit "$index" "$scope" "$scope_width" "$terminal_columns" "$reverse"
          first_commit=0
        else
          print_commit "$index" '' "$scope_width" "$terminal_columns" "$reverse"
        fi
      fi
      index=$((index + 1))
    done
  done
}

render_repository() {
  local repo=$1
  local count=$2
  local revision=$3
  local revision_is_explicit=$4
  local reverse=$5
  local compact=$6
  local collect_status
  local excluded_branch=
  local scope_width
  local terminal_columns

  if ! git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    printf 'Not a Git repository: %s\n' "$repo"
    return 0
  fi

  if [ "$revision_is_explicit" -eq 0 ]; then
    excluded_branch=$(git -C "$repo" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
  fi

  collect_commits "$repo" "$revision" "$count" "$excluded_branch" "$reverse"
  collect_status=$?
  case "$collect_status" in
    0) ;;
    2)
      printf 'No commits\n'
      return 0
      ;;
    *) return 1 ;;
  esac

  if [ "${#COMMIT_HASHES[@]}" -eq 0 ]; then
    printf 'No commits\n'
    return 0
  fi

  setup_colors
  terminal_columns=$(terminal_width)
  scope_width=$(scope_field_width)
  render_commits "$scope_width" "$terminal_columns" "$reverse" "$compact"
}

is_positive_integer() {
  case "$1" in
    ''|*[!0-9]*) return 1 ;;
    *[1-9]*) return 0 ;;
    *) return 1 ;;
  esac
}

main() {
  local repo=.
  local count=15
  local revision=HEAD
  local revision_set=0
  local count_set=0
  local reverse=0
  local compact=0

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help)
        usage
        return 0
        ;;
      -C|-d)
        if [ "$#" -lt 2 ]; then
          usage >&2
          return 2
        fi
        repo=$2
        shift 2
        ;;
      -n)
        if [ "$#" -lt 2 ] || ! is_positive_integer "$2"; then
          usage >&2
          return 2
        fi
        count=$2
        count_set=1
        shift 2
        ;;
      -c)
        compact=1
        shift
        ;;
      -r)
        reverse=1
        shift
        ;;
      -*)
        usage >&2
        return 2
        ;;
      *)
        if [ "$revision_set" -eq 1 ]; then
          usage >&2
          return 2
        fi
        revision=$1
        revision_set=1
        shift
        ;;
    esac
  done

  if [ "$revision_set" -eq 1 ] && [ "$count_set" -eq 0 ]; then
    count=
  fi

  render_repository "$repo" "$count" "$revision" "$revision_set" "$reverse" "$compact"
}

main "$@"
